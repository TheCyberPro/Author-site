<div class="md-editor" data-editor data-key="<%= editorKey %>">
  <div class="ed-top">
    <label class="ed-label" for="ed-<%= name %>"><%= label %></label>
    <div class="ed-tabs">
      <button type="button" class="ed-tab active" data-mode="write">Write</button>
      <button type="button" class="ed-tab ed-split" data-mode="split">Split</button>
      <button type="button" class="ed-tab" data-mode="preview">Preview</button>
    </div>
  </div>
  <div class="ed-toolbar" role="toolbar" aria-label="Formatting">
    <button type="button" data-cmd="bold" title="Bold (Ctrl+B)"><strong>B</strong></button>
    <button type="button" data-cmd="italic" title="Italic (Ctrl+I)"><em>I</em></button>
    <button type="button" data-cmd="h2" title="Heading">H2</button>
    <button type="button" data-cmd="h3" title="Subheading">H3</button>
    <button type="button" data-cmd="quote" title="Blockquote">❝ Quote</button>
    <button type="button" data-cmd="ul" title="Bulleted list">• List</button>
    <button type="button" data-cmd="ol" title="Numbered list">1. List</button>
    <button type="button" data-cmd="link" title="Link">Link</button>
    <button type="button" data-cmd="code" title="Code — inline, or a block when the selection spans lines">Code</button>
    <button type="button" data-cmd="image" title="Image">Image</button>
    <button type="button" data-cmd="hr" title="Divider">—</button>
  </div>
  <div class="ed-restore" hidden data-restore>
    <span>A locally saved version of this text was found.</span>
    <button type="button" class="btn ghost sm" data-restore-yes>Restore it</button>
    <button type="button" class="btn ghost sm" data-restore-no>Discard</button>
  </div>
  <div class="ed-body mode-write">
    <textarea id="ed-<%= name %>" class="ed-area" name="<%= name %>" rows="18" placeholder="<%= placeholder %>" spellcheck="true"><%= value %></textarea>
    <div class="ed-preview prose" aria-label="Preview"><%- renderMd(value) %></div>
  </div>
  <div class="ed-foot">
    <span data-words>0 words</span><span class="sep">·</span><span data-read>1 min read</span>
    <details class="ed-help">
      <summary>Formatting help</summary>
      <div class="ed-cheatsheet">
        <code>**bold**</code><code>*italic*</code><code>## Heading</code><code>&gt; quote</code><code>- list</code><code>1. list</code><code>[text](https://…)</code><code>![alt](/covers/…)</code><code>`code`</code><code>---</code>
      </div>
    </details>
    <span class="ed-save" data-save-note></span>
  </div>
</div>
