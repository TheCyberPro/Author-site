<% pageTitle = 'Subscribers'; bodyClass = 'admin'; %>
<%- include('partials/head') %>
<div class="container wide">
  <div class="page-head">
    <div>
      <p class="kicker">The desk</p>
      <h1 class="page-title">Subscribers<span class="tick">.</span></h1>
      <p class="page-note"><%= subscribers.length %> reader<%= subscribers.length === 1 ? '' : 's' %> on The Margin. Export the list to send letters with any email service.</p>
    </div>
    <% if(subscribers.length){ %>
    <div class="head-actions">
      <button class="btn ghost" type="button" id="copyEmails">Copy emails</button>
      <a class="btn primary" href="/admin/subscribers.csv">Export CSV ↓</a>
    </div>
    <% } %>
  </div>
  <% if(subscribers.length){ %>
  <div class="plist subs">
    <div class="plist-head"><span>Email</span><span>Subscribed</span><span class="ph-actions">Actions</span></div>
    <% subscribers.forEach(s => { %>
    <div class="prow">
      <span class="sub-email"><%= s.email %></span>
      <span class="prow-date"><%= fmtDate(s.created_at) %></span>
      <div class="prow-actions">
        <form method="post" action="/admin/subscribers/<%= s.id %>/delete" data-confirm="Remove <%= s.email %> from the list?" data-confirm-label="Remove">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <button class="btn danger sm" type="submit">Remove</button>
        </form>
      </div>
    </div>
    <% }); %>
  </div>
  <% } else { %>
  <div class="empty">
    <p class="empty-mark">¶</p>
    <h2>No subscribers yet</h2>
    <p>The signup form lives in the footer of every public page.</p>
  </div>
  <% } %>
</div>
<%- include('partials/foot') %>
